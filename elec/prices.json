  "print_material_factor": {
    "usd": null,
    "factor": 0.45,
    "verified": "m",
    "what": [
      "Fraction of SOLID volume that actually becomes filament. Walls plus sparse",
      "infill: a 4-wall / 15% part lands near 0.40-0.50 depending on how much of it",
      "is wall. THIS IS A GUESS and it moves the plastic line by more than any",
      "other single number here -- 5175 cm3 of PETG-GF is 6.8 kg solid and about",
      "3.1 kg at 0.45. Slice one chassis segment and read the real figure off the",
      "slicer; that one measurement is worth more than every other estimate in",
      "this file."
    ]
  }

	(property "Reference" "REF**" (at 0 -18.6 0) (layer "F.SilkS") (effects (font (size 0.8 0.8) (thickness 0.12))))
	(property "Value" "KPJX-4S-S" (at 0 -1.5 0) (layer "F.Fab") (effects (font (size 0.8 0.8) (thickness 0.12))))

[Unit]
Description=USB gadget on the Pi's USB-C
After=sys-kernel-config.mount
Requires=sys-kernel-config.mount

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/bin/public-steel-guitar-gadget.sh
ExecStop=/usr/local/bin/public-steel-guitar-gadget.sh stop

[Install]
WantedBy=multi-user.target

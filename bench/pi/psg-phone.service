[Unit]
Description=Phone pitch page, https://public-steel-guitar.home
After=network-online.target avahi-daemon.service
Wants=network-online.target

[Service]
# install.sh copies bench/pi and bench/psgbench here
WorkingDirectory=/opt/psg/bench/pi/phone
ExecStart=/usr/bin/python3 server.py --port 80 --state /var/lib/psg-phone/state.json --tls-dir /var/lib/psg-phone/tls
Restart=always
RestartSec=2
# install.sh writes the user who ran it: the bench scripts' user
User=psg
SupplementaryGroups=dialout
AmbientCapabilities=CAP_NET_BIND_SERVICE
StateDirectory=psg-phone

[Install]
WantedBy=multi-user.target
